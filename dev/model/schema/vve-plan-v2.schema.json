{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dburgers84.github.io/vve-van-speijk-kaart/model/schema/vve-plan-v2.schema.json",
  "title": "VvE Van Speijk plattegrond-datamodel v2 (brongetrouw)",
  "description": "Structuurschema. Semantische regels (referenties, topologie, maatstatus-consistentie) staan in model/validate.py.",
  "type": "object",
  "required": ["schema_version", "dataset_version", "sources", "calibrations", "frames", "floors", "objects", "vertices", "edges", "labels", "connections", "legal_splits", "legal_split_ui", "memberships", "legacy_links", "coverage", "review_log"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^vve-plan/2\\.\\d+\\.\\d+$"},
    "dataset_version": {"type": "string"},
    "generated": {"type": "string"},
    "regions": {"type": "array", "items": {"type": "object", "required": ["id", "name", "region_px", "floor_id"]}},
    "reference_overlays": {"type": "array", "items": {"type": "object", "required": ["id", "frame_id", "image", "public", "image_to_native_affine"], "properties": {"public": {"type": "boolean"}}}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "calibrations": {"type": "array", "items": {"$ref": "#/$defs/calibration"}},
    "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}},
    "floors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/floor"}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "vertices": {"type": "array", "items": {"$ref": "#/$defs/vertex"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "legal_splits": {"type": "array", "items": {"$ref": "#/$defs/legal_split"}},
    "legal_split_ui": {"type": "object", "required": ["enabled", "reason"], "properties": {"enabled": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}},
    "memberships": {"type": "array", "items": {"$ref": "#/$defs/membership"}},
    "legacy_links": {"type": "array", "items": {"$ref": "#/$defs/legacy_link"}},
    "coverage": {"type": "object", "required": ["complete", "scope", "floors_covered", "traced", "not_traced"], "properties": {"complete": {"type": "boolean"}}},
    "review_log": {"type": "array"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[A-Za-z0-9]+)+$"},
    "certainty": {"enum": ["source", "probable", "uncertain", "unresolved", "unknown", "source_label_context"]},
    "evidence": {"type": ["object", "null"], "required": ["source_id", "method"], "properties": {"source_id": {"type": "string"}, "method": {"type": "string"}, "note": {"type": "string"}}},
    "source": {"type": "object", "required": ["id", "page", "privacy_class", "publish_native_raster"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "page": {"type": "integer"}, "native_size_px": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
      "scan_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "pdf_extract_sha256": {"type": ["string", "null"]},
      "privacy_class": {"enum": ["public", "private_deed_drawing", "private_personal_data"]}, "publish_native_raster": {"type": "boolean"}}},
    "calibration": {"type": "object", "required": ["id", "frame_id", "model", "status", "uncertainty_m", "uncertainty_status"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "model": {"enum": ["none", "nominal_scale", "similarity", "affine", "projective", "piecewise"]},
      "m_per_px_x": {"type": ["number", "null"], "exclusiveMinimum": 0}, "m_per_px_y": {"type": ["number", "null"], "exclusiveMinimum": 0},
      "uncertainty_m": {"type": ["number", "null"], "minimum": 0}, "uncertainty_status": {"enum": ["unknown", "estimated", "measured"]},
      "status": {"enum": ["none", "nominal_unverified", "fitted_unreviewed",
            "controls_checked_one_axis", "verified"]}, "control_points": {"type": "array"}}},
    "frame": {"type": "object", "required": ["id", "source_id", "floor_id", "unit", "width_px", "height_px"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "unit": {"const": "px_native"}, "width_px": {"type": "integer"}, "height_px": {"type": "integer"}, "calibration_ids": {"type": "array", "items": {"type": "string"}}}},
    "floor": {"type": "object", "required": ["id", "name", "level"], "properties": {"id": {"type": "string"}, "level": {"type": "integer"}}},
    "vertex": {"type": "object", "required": ["id", "frame_id", "floor_id", "x_px", "y_px", "x_rel", "y_rel"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "x_px": {"type": "number"}, "y_px": {"type": "number"},
      "x_rel": {"type": "number", "minimum": 0, "maximum": 1}, "y_rel": {"type": "number", "minimum": 0, "maximum": 1},
      "positional_tolerance_px": {"type": ["number", "null"], "minimum": 0}}},
    "dimension": {"type": "object", "required": ["status", "length_m", "uncertainty_m", "uncertainty_status", "method", "calibration_ref", "source_text", "source_ref"], "properties": {
      "status": {"enum": ["source", "derived", "unknown"]}, "length_m": {"type": ["number", "null"], "minimum": 0},
      "uncertainty_m": {"type": ["number", "null"], "minimum": 0}, "uncertainty_status": {"enum": ["unknown", "estimated", "measured", "stated"]},
      "method": {"type": ["string", "null"]}, "calibration_ref": {"type": ["string", "null"]}, "source_text": {"type": ["string", "null"]}, "source_ref": {"type": ["object", "string", "null"]}}},
    "edge": {"type": "object", "required": ["id", "frame_id", "floor_id", "v", "role", "dimension"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "v": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
      "role": {"enum": ["wall_drawn", "wall_drawn_thin", "wall_inner_face", "facade", "virtual_opening", "virtual_boundary", "railing", "roof_edge", "element_outline"]},
      "dimension": {"$ref": "#/$defs/dimension"}, "trace_quality": {"enum": ["ink_confirmed", "partial_ink", "not_applicable", null]}}},
    "object": {"type": "object", "required": ["id", "revision", "floor_id", "frame_id", "kind", "class", "geometry", "edge_ids", "label_ids", "certainty", "review_status"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1},
      "class": {"enum": ["space", "element", "linear_feature", "point_feature"]},
      "source_label_text": {"type": ["string", "null"]},
      "current_use": {"type": ["object", "null"], "required": ["value", "source", "certainty"]},
      "kind": {"type": "string"},
      "certainty": {"$ref": "#/$defs/certainty"},
      "review_status": {"enum": ["needs_review", "reviewed", "rejected"]},
      "geometry": {"oneOf": [
        {"type": "object", "required": ["type", "rings"], "properties": {"type": {"const": "Polygon"}, "rings": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 3, "items": {"type": "string"}}}}},
        {"type": "object", "required": ["type", "vertices"], "properties": {"type": {"const": "LineString"}, "vertices": {"type": "array", "minItems": 2, "items": {"type": "string"}}}},
        {"type": "object", "required": ["type", "vertex"], "properties": {"type": {"const": "Point"}, "vertex": {"type": "string"}}}]}}},
    "label": {"type": "object", "required": ["id", "literal_text", "category", "bbox_px", "assigned_object_ids", "certainty"], "properties": {
      "literal_text": {"type": ["string", "null"]}, "category": {"enum": ["space_name", "index_number", "index_number_candidate", "bouw_nr", "address", "dimension", "note", "street_name"]},
      "bbox_px": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}, "assigned_object_ids": {"type": "array", "items": {"type": "string"}}, "certainty": {"$ref": "#/$defs/certainty"}}},
    "connection": {"type": "object", "required": ["id", "kind", "edge_id", "connects", "certainty"], "properties": {
      "kind": {"enum": ["opening", "opening_candidate", "door", "stair_link", "lift_link"]}, "edge_id": {"type": ["string", "null"]},
      "connects": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}, "certainty": {"$ref": "#/$defs/certainty"}}},
    "legal_split": {"type": "object", "required": ["id", "name", "status", "boundary_status"], "properties": {
      "status": {"enum": ["identified_in_source", "referenced_not_located", "hypothesis"]}, "boundary_status": {"enum": ["unknown", "partial", "traced"]}, "parent_id": {"type": ["string", "null"]}}},
    "membership": {"type": "object", "required": ["object_id", "split_id", "relation", "certainty"], "properties": {
      "relation": {"enum": ["private", "common", "excluded", "context", "unknown"]}, "right_id": {"type": ["string", "null"]}, "certainty": {"$ref": "#/$defs/certainty"}, "evidence": {"type": ["object", "null"]}}},
    "legacy_link": {"type": "object", "required": ["legacy_system", "legacy_id", "object_id", "relation", "certainty"], "properties": {
      "legacy_system": {"enum": ["svg_v2_common_json", "svg_v2_units_json", "melding", "gps_photo", "walk_photo"]}}}
  }
}
